http:
  listeners:
  - name: web
    resources:
    - name: discovery
    - name: human
    - name: oauth
    - name: compat
    - name: graphql
    - name: assets
      path: /mas/share/assets
    binds:
    - address: '[::]:8081'
    prefix: {{ mas_prefix }}
    proxy_protocol: false
  - name: internal
    resources:
    - name: health
    binds:
    - host: localhost
      port: 8082
    proxy_protocol: false
  public_base: {{ synapse_public_baseurl }}{{ mas_prefix }}
database:
  uri: {{ mas_database_uri }}
secrets:
  encryption: "{{ encryption_key }}"
  keys:
    - kid: "{{ signing_key_id }}"
      key: |
{% for line in signing_key_rsa.splitlines() %}
        {{ line }}
{% endfor %}
passwords:
    enabled: {{ enable_password_config }}
matrix:
  homeserver: {{ synapse_server_name_config }}
  secret: "{{ synapse_shared_secret }}"
  endpoint: http://{{ synapse_main_unit_address }}:8008
clients:
  - client_id: {{ synapse_oidc_client_id }}
    client_auth_method: client_secret_basic
    client_secret: "{{ synapse_oidc_client_secret }}"
templates:
  path: /mas/share/templates
  assets_manifest: /mas/share/manifest.json
  translations_path: /mas/share/translations
policy:
  wasm_module: /mas/share/policy.wasm
{% if oauth_provider_info is not none %}
upstream_oauth2:
  providers:
    - id: {{ upstream_oidc_provider_id }}
      human_name: Single Sign-On
      issuer: {{ oauth_provider_info.issuer_url }}
      client_id: {{ oauth_provider_info.client_id }}
      client_secret: {{ oauth_provider_info.client_secret }}
      scope: "{{ mas_oidc_scope }}"
      token_endpoint_auth_method: client_secret_basic
      discovery_mode: oidc
      claims_imports:
          subject:
              action: require
              template: {{ oidc_subject_claim }}
          displayname:
              action: suggest
              template: {{ '"{{ user.name }}"' }}
          localpart:
              action: ignore
          email:
              action: suggest
              template: {{ '"{{ user.email }}"' }}
{% endif %}
{% if smtp_configuration is not none %}
email:
  from: '"{{ synapse_server_name_config }}" <auth@{{ synapse_server_name_config }}>'
  reply_to: '"No reply" <no-reply@{{ synapse_server_name_config }}>'
  transport: smtp
{% if smtp_configuration.enable_tls %}
  mode: tls
{% else %}
  mode: plain
{% endif %}
  hostname: {{ smtp_configuration.host }}
  port: {{ smtp_configuration.port }}
  username: {{ smtp_configuration.user }}
  password: {{ smtp_configuration.password }}
{% endif %}